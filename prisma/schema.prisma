// Dharohar AR — Prisma schema
// Provider: SQLite locally, hosted libSQL (Turso) in production.
// Notes for SQLite: no native enums, no scalar lists. Enum-like fields are
// strings validated by Zod in src/lib/schemas.ts; arrays are JSON text.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Roles: VISITOR | ADMIN
// Status: DRAFT | PUBLISHED | ARCHIVED
// ScanMethod: QR | MANUAL | AR | VR

model Room {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  floor          String
  intro          String? // one or two sentences shown above the 360° viewer
  panoramaUrl    String? // /panoramas/<file> in public, or /api/panoramas/<id>
  panoramaCredit String? // the licence line under the 360° viewer
  exhibits       Exhibit[]
  panorama       RoomPanorama?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/**
 * A 360° panorama uploaded from the Studio, stored in the database for the same
 * reason as `ModelAsset`: the deployed filesystem is read-only. A 3072x1536
 * WebP is about 0.7 MB, comfortably under the 4 MB cap, so a room's whole
 * picture can be replaced from the browser instead of a redeploy.
 */
model RoomPanorama {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String   @default("image/webp")
  size      Int
  sha256    String
  width     Int
  height    Int
  bytes     Bytes
  createdAt DateTime @default(now())

  roomId String @unique
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Exhibit {
  id          String   @id @default(cuid())
  slug        String   @unique
  code        String   @unique // printed under the QR, e.g. "TH01"
  title       String
  subtitle    String?
  era         String
  yearStart   Int?
  yearEnd     Int?
  roomId      String
  summary     String
  body        String
  facts       String   @default("[]") // JSON string[]
  heroImage   String
  audioUrl    String?
  transcript  String?
  modelUrl    String?
  modelUsdz   String?
  modelScale  Float    @default(1)
  tags        String   @default("") // comma separated
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room     Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hotspots Hotspot[]
  gallery  Media[]
  scans    Scan[]
  reviews  Review[]
  stops    TourStop[]
  stamps   Stamp[]

  modelAsset ModelAsset?

  @@index([roomId])
  @@index([status])
}

/**
 * A model uploaded from the Studio, stored in the database rather than on disk.
 *
 * Vercel's filesystem is read-only at runtime, so an upload has nowhere to go
 * except object storage or the database. At 0.2-4 MB per scan the database is
 * the cheaper answer: no new dependency, no token, and the row is deleted with
 * its exhibit. `bytes` is served by /api/models/[id] with an immutable cache
 * header, which is safe because a replacement upload gets a new id.
 */
model ModelAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String   @default("model/gltf-binary")
  size      Int
  sha256    String
  draco     Boolean  @default(false)
  credit    String?
  bytes     Bytes
  createdAt DateTime @default(now())

  exhibitId String  @unique
  exhibit   Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
}

model Hotspot {
  id        String  @id @default(cuid())
  exhibitId String
  label     String
  body      String
  posX      Float   @default(0)
  posY      Float   @default(0)
  posZ      Float   @default(0)
  order     Int     @default(0)

  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@index([exhibitId])
}

model Media {
  id        String  @id @default(cuid())
  exhibitId String?
  url       String
  kind      String // IMAGE | AUDIO | VIDEO | MODEL | PANORAMA
  alt       String
  credit    String?
  order     Int     @default(0)

  exhibit Exhibit? @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@index([exhibitId])
}

model Tour {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  theme       String
  durationMin Int
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  stops       TourStop[]
}

model TourStop {
  id        String  @id @default(cuid())
  tourId    String
  exhibitId String
  position  Int
  blurb     String?

  tour    Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@unique([tourId, exhibitId])
  @@index([tourId, position])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   @default("VISITOR") // VISITOR | ADMIN
  emailVerified Boolean @default(false)
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews Review[]
  stamps  Stamp[]
  scans   Scan[]
  sessions Session[]
  accounts Account[]
}

/**
 * Better Auth tables. Field names follow its Prisma adapter contract, so the
 * camelCase columns below are deliberate — do not "tidy" them into snake_case.
 */
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Review {
  id        String   @id @default(cuid())
  exhibitId String
  userId    String
  rating    Int // 1..5
  body      String
  status    String   @default("VISIBLE") // VISIBLE | HIDDEN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exhibitId]) // one review per exhibit per visitor
  @@index([exhibitId, status, createdAt])
}

model Scan {
  id        String   @id @default(cuid())
  exhibitId String
  method    String   @default("QR") // QR | MANUAL | AR | VR
  deviceId  String
  userId    String?
  createdAt DateTime @default(now())

  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([exhibitId, createdAt])
  @@index([deviceId])
}

model Stamp {
  id          String   @id @default(cuid())
  deviceId    String
  userId      String?
  exhibitId   String
  firstSeenAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@unique([deviceId, exhibitId])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(cuid())
  exhibitId String?
  rating    Int
  message   String
  contact   String?
  status    String   @default("NEW") // NEW | READ | CLOSED
  createdAt DateTime @default(now())
}

// Better Auth tables (sessions, accounts, verification) are added in week 2.

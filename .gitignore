# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# env sample is committed
!.env.example

# local agent tooling
.agents/
.claude/
.windsurf/
skills-lock.json


# local database
prisma/*.db
prisma/*.db-journal

# a staging folder for models fetched from Poly Haven: large binaries that are
# uploaded through the Studio, not committed. See models-extra/CREDITS.md.
/models-extra/

# local HTTPS: dev certificate, its key, and the CA cert served to the phone
/certs/
/public/dev-ca.crt

# the marker cards encode whichever origin generated them, so a committed PDF
# would be a card that only scans on one machine. Run `npm run print:cards`.
/docs/marker-cards.pdf

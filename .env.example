# Copy to .env and fill in. Never commit .env
DATABASE_URL="file:./prisma/dev.db"

# Public site URL — used for QR codes and share links.
# For testing QR codes from a phone on the same wifi, use your LAN IP:
#   NEXT_PUBLIC_SITE_URL="https://192.168.1.42:3000"
# HTTPS is required for camera access (/scan), WebXR AR and device orientation
# (VR). Run `npm run dev:https` after generating a cert with mkcert:
#   mkcert -cert-file certs/dev-cert.pem -key-file certs/dev-key.pem <lan-ip> localhost 127.0.0.1
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dev only: LAN hosts allowed to load /_next assets (comma separated, no scheme).
# Without this, a phone can fetch the HTML but never hydrates.
DEV_ALLOWED_ORIGINS="192.168.1.42"

# Auth (week 2) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary (week 4)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

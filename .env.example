# Copy to .env and fill in. Never commit .env
DATABASE_URL="file:./prisma/dev.db"

# Canonical public URL. Keep it on localhost: QR cards and redirects use the
# request's Host header, so a phone that opens the LAN address still gets LAN
# links. HTTPS is required for camera access (/scan), WebXR AR and device
# orientation (VR) — run `npm run dev:https`; scripts/https-cert.mjs generates
# the mkcert certificate for every local IPv4 plus localhost.
NEXT_PUBLIC_SITE_URL="https://localhost:3000"

# Dev only: LAN hosts allowed to load /_next assets (comma separated, no scheme).
# Without this, a phone can fetch the HTML but never hydrates. Better Auth also
# trusts these origins for sign-in.
DEV_ALLOWED_ORIGINS="192.168.1.42"

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://localhost:3000"

# Cloudinary (week 4)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
